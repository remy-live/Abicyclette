{
  "name": "À bicyclette — carte vélo & navigation",
  "short_name": "À bicyclette",
  "description": "Carte vélo, itinéraires, points d'eau, lieux à visiter et navigation GPS, même hors ligne.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#e5e7eb",
  "theme_color": "#059669",
  "lang": "fr",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "./?partage-gpx",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "gpx",
          "accept": [
            ".gpx",
            "application/gpx+xml",
            "application/xml",
            "text/xml",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ]
      }
    }
  ],
  "shortcuts": [
    {
      "name": "Rentrer à la maison",
      "short_name": "Maison",
      "url": "./?aller=domicile",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Aller au travail",
      "short_name": "Travail",
      "url": "./?aller=travail",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}